#include "corne_xiao_v2.dtsi"

&kscan0 {
    col-gpios
        = <&xiao_d 6 GPIO_ACTIVE_HIGH>
        , <&xiao_d 5 GPIO_ACTIVE_HIGH>
        , <&xiao_d 4 GPIO_ACTIVE_HIGH>
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 7 GPIO_ACTIVE_HIGH>
        , <&gpio0  9 GPIO_ACTIVE_HIGH>
        ;
};

&pinctrl {
    spi2_no_miso: spi2_no_miso {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 15)>;
        };
    };
    spi2_no_miso_sleep: spi2_no_miso_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 15)>;
            low-power-enable;
        };
    };
};

nice_view_spi: &spi2 {
    status = "okay";
    pinctrl-0 = <&spi2_no_miso>;
    pinctrl-1 = <&spi2_no_miso_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&xiao_d 9 GPIO_ACTIVE_HIGH>;
    clock-frequency = <4000000>;
};

&zip_inertia {
    trigger-ms = <35>;

    move-decay-factor-int = <90>;
    move-report-interval-ms = <35>;
    move-threshold-start = <15>;
    move-threshold-stop = <1>;
};

&glidepoint_listener {
    status = "okay";
    input-processors = <&zip_inertia>;
};

