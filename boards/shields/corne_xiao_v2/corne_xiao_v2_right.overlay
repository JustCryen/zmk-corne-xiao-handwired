#include "corne_xiao_v2.dtsi"

&default_transform {
    col-offset = <6>;
};

&five_column_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&gpio0  10 GPIO_ACTIVE_HIGH>
        , <&gpio0  9  GPIO_ACTIVE_HIGH>
        , <&xiao_d 9  GPIO_ACTIVE_HIGH>
        , <&xiao_d 8  GPIO_ACTIVE_HIGH>
        , <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 6  GPIO_ACTIVE_HIGH>
        ;
};

&xiao_i2c {
    status = "okay";

    glidepoint: glidepoint@2a {
        compatible = "cirque,pinnacle2";
        reg = <0x2a>;
        status = "okay";
        data-ready-gpios = <&xiao_d 7 (GPIO_ACTIVE_HIGH)>;

        sensitivity = "2x";
        swap-xy;
        invert-x;
        data-mode = "absolute";
        absolute-relative-divisor = <4>;
        absolute-edge-motion-enable;
        absolute-right-edge-scroll-enable;
        absolute-top-edge-scroll-enable;
        primary-tap-enable;
        sleep-mode-enable;
    };
};

&glidepoint_split {
    device = <&glidepoint>;
};

